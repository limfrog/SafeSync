<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SafeSync · 확인할 메시지" Width="980" Height="580" MinWidth="640" MinHeight="360" ShowInTaskbar="False" Background="{DynamicResource SafeSyncWindowBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" FontFamily="Segoe UI, Malgun Gothic" WindowStartupLocation="CenterScreen">
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,14"><TextBlock Text="확인할 메시지" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="MessageCountText" Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,5,0,0"/></StackPanel>
<Grid Grid.Row="1"><DataGrid x:Name="MessagesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="58" Background="{DynamicResource SafeSyncSurfaceBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" BorderBrush="{DynamicResource SafeSyncBorderBrush}" HorizontalGridLinesBrush="{DynamicResource SafeSyncBorderSoftBrush}" VerticalGridLinesBrush="{DynamicResource SafeSyncBorderSoftBrush}" GridLinesVisibility="Horizontal"><DataGrid.Columns>
<DataGridTextColumn Header="작업" Binding="{Binding JobName}" Width="160"/>
<DataGridTextColumn Header="파일 / 경로" Binding="{Binding File}" Width="1.3*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding File}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
<DataGridTextColumn Header="내용" Binding="{Binding Message}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
</DataGrid.Columns></DataGrid><TextBlock x:Name="MessagesEmptyText" Text="확인할 메시지가 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SafeSyncMutedBrush}" IsHitTestVisible="False"/></Grid>
<DockPanel Grid.Row="2" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="ResolveMessageButton" Content="선택 작업 문제 해결" Margin="0,0,8,0"/><Button x:Name="ClearMessagesButton" Content="표시한 메시지 비우기"/><Button x:Name="CloseMessagesButton" Content="닫기" Margin="8,0,0,0"/></StackPanel><TextBlock Text="메시지만 지웁니다. 오류·충돌 상태와 백업 파일은 변경하지 않습니다." Foreground="{DynamicResource SafeSyncMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/></DockPanel>
</Grid></Window>
