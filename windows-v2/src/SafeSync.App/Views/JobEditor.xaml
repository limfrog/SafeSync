<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="백업 · 동기화 작업" Width="720" Height="650" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource SafeSyncWindowBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" FontFamily="Segoe UI, Malgun Gothic">
  <Window.Resources>
   <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/></Style>
   <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource SafeSyncInputBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource SafeSyncTextBrush}"/></Style>
   <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="32"/></Style>
   <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SafeSyncInputBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ComboBox}">
     <Grid>
      <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
       <ToggleButton.Template><ControlTemplate TargetType="{x:Type ToggleButton}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><Path Data="M 0,0 L 4,4 L 8,0 Z" Fill="{TemplateBinding Foreground}" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/></Border></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,30,0"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Width="{Binding ActualWidth,ElementName=DropDownToggle}" Background="{DynamicResource SafeSyncSurfaceBrush}" BorderBrush="{DynamicResource SafeSyncBorderBrush}" BorderThickness="1" Padding="2"><ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
     </Grid>
     <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropDownToggle" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="Padding" Value="9,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ComboBoxItem}"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SafeSyncSubtleBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SafeSyncAccentDarkBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="14" Height="14" Fill="{DynamicResource SafeSyncInputBrush}" Stroke="{DynamicResource SafeSyncMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/><Ellipse x:Name="RadioDot" Width="8" Height="8" Margin="3,0,0,0" Fill="{DynamicResource SafeSyncAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" ContentSource="Content" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioDot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type CheckBox}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="CheckBoxBorder" Width="15" Height="15" Margin="0,1,4,0" VerticalAlignment="Top" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2"/><Path x:Name="CheckMark" Data="M 3,7 L 6,10 L 12,3" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Top" Margin="0,1,4,0" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SafeSyncAccentBrush}"/><Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource SafeSyncAccentBrush}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type GroupBox}"><Grid><Border Margin="0,8,0,0" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter Margin="0,7,0,0" ContentSource="Content"/></Border><Border Background="{DynamicResource SafeSyncWindowBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,0,0,0" Padding="4,0"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="백업 · 동기화 작업 설정" FontSize="23" FontWeight="Bold"/>
    <StackPanel Orientation="Horizontal" Margin="0,16,0,8"><RadioButton x:Name="OneWayRadio" GroupName="SyncMode" Content="단방향 백업 →" Margin="0,0,26,0"/><RadioButton x:Name="TwoWayRadio" GroupName="SyncMode" Content="양방향 동기화 ↔"/></StackPanel>
    <TextBlock x:Name="ModeHintText" Text="단방향: 원본의 변경을 백업 위치에 반영합니다." TextWrapping="Wrap" Foreground="{DynamicResource SafeSyncMutedBrush}" FontSize="12"/>
   </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="작업 이름" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" Padding="8"/></Grid>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="원본 위치" VerticalAlignment="Center"/><TextBox x:Name="SourceBox" Grid.Column="1" Padding="8"/><Button x:Name="SourceBrowse" Grid.Column="2" Content="찾아보기" Margin="8,0,0,0"/></Grid>
  <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="백업 방식" VerticalAlignment="Center"/><ComboBox x:Name="DestinationTypeBox" Grid.Column="1" Padding="7"><ComboBoxItem Content="로컬 / 네트워크 / 동기화 폴더" Tag="Local"/><ComboBoxItem Content="Dropbox API" Tag="Dropbox"/><ComboBoxItem Content="Google Drive API" Tag="GoogleDrive"/></ComboBox></Grid>
  <Grid Grid.Row="4" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="백업 위치" VerticalAlignment="Center"/><TextBox x:Name="DestinationBox" Grid.Column="1" Padding="8" IsReadOnly="True"/><Button x:Name="DestinationBrowse" Grid.Column="2" Content="위치 선택" Margin="8,0,0,0"/></Grid>
  <GroupBox Grid.Row="5" Header="실행 방식" Padding="12" Margin="0,0,0,12"><StackPanel><RadioButton x:Name="RealtimeRadio" Content="파일시스템에 변화가 있으면 자동 백업" Margin="0,3,0,9"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="ScheduleRadio" Content="매일 정해진 시간에 백업" VerticalAlignment="Center"/><TextBox x:Name="TimeBox" Width="70" Margin="14,0,0,0" Padding="5" ToolTip="예: 23:30"/></StackPanel></StackPanel></GroupBox>
  <CheckBox Grid.Row="6" x:Name="MirrorCheck" Content="원본에서 사라진 파일은 백업 위치의 SafeSync 휴지통으로 이동" VerticalAlignment="Top" Margin="0,4,0,0"/>
 </Grid></ScrollViewer>
   <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="취소" Padding="18,8" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="저장" Padding="22,8" Background="{DynamicResource SafeSyncAccentBrush}" Foreground="White" BorderBrush="{DynamicResource SafeSyncAccentBrush}"/></StackPanel>
 </Grid>
</Window>
