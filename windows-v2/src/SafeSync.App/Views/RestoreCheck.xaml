<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SafeSync 백업 복원 검증" Width="960" Height="650" MinWidth="740" MinHeight="480" Background="{DynamicResource SafeSyncWindowBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic" FontSize="12">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SafeSyncSubtleBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="Padding" Value="8"/></Style></Window.Resources>
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="백업 복원 검증" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="LocationText" Margin="0,10" TextWrapping="Wrap"/><TextBlock Text="백업을 읽어 마지막 성공 기록의 체크섬과 비교합니다. 클라우드는 별도 임시 위치에 내려받은 뒤 검사하고 정리하며, 원래 위치에 복원하거나 덮어쓰지 않습니다. 검증 동안 이 작업만 잠시 일시정지하고 끝나면 기존 상태로 돌아갑니다." TextWrapping="Wrap" Foreground="{DynamicResource SafeSyncMutedBrush}"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,14"><TextBlock x:Name="StatusText" Text="검증 시작을 누르세요. 큰 백업은 시간이 오래 걸릴 수 있습니다." TextWrapping="Wrap"/><ProgressBar x:Name="WorkProgress" Visibility="Collapsed" IsIndeterminate="True" Height="3" Margin="0,8,0,0"/></StackPanel>
<DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" RowHeight="34" HeadersVisibility="Column" Background="{DynamicResource SafeSyncSurfaceBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" RowBackground="{DynamicResource SafeSyncSurfaceBrush}" AlternatingRowBackground="{DynamicResource SafeSyncSubtleBrush}"><DataGrid.Columns><DataGridTextColumn Header="파일 경로" Binding="{Binding Path}" Width="2*"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="검증 결과" Binding="{Binding Detail}" Width="3*"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="StartButton" Content="검증 시작" Background="{DynamicResource SafeSyncAccentBrush}" Foreground="White"/><Button x:Name="CancelButton" Content="검증 취소" IsEnabled="False"/><Button x:Name="CloseButton" Content="닫기"/></StackPanel></Grid></Window>
