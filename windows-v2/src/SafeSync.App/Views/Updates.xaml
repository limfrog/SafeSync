<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SafeSync 업데이트" Width="600" Height="470" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterScreen" Background="{DynamicResource SafeSyncWindowBrush}" FontFamily="Segoe UI, Malgun Gothic">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="SafeSync 업데이트" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SafeSyncTextBrush}"/><TextBlock x:Name="InstalledVersionText" Margin="0,8,0,0" Foreground="{DynamicResource SafeSyncMutedBrush}"/><TextBlock x:Name="AvailableVersionText" Margin="0,5,0,16" Foreground="{DynamicResource SafeSyncAccentBrush}" FontWeight="SemiBold"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="{DynamicResource SafeSyncTextBrush}" Margin="0,0,0,12"/>
   <ProgressBar x:Name="UpdateDownloadProgress" Height="10" Minimum="0" Maximum="1" Margin="0,0,0,16" Background="{DynamicResource SafeSyncSubtleBrush}" Foreground="{DynamicResource SafeSyncAccentBrush}" BorderThickness="0"/>
   <TextBlock x:Name="UpdateNotesText" TextWrapping="Wrap" Foreground="{DynamicResource SafeSyncMutedBrush}"/>
   <TextBlock Text="백업 중에도 다운로드할 수 있습니다. 설치 시 현재 파일을 마친 뒤 앱을 종료합니다. 알림음은 재생하지 않습니다." TextWrapping="Wrap" Margin="0,18,0,0" Foreground="{DynamicResource SafeSyncMutedBrush}"/>
  </StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button x:Name="UpdateCheckButton" Content="업데이트 확인" Padding="12,8" Margin="0,0,8,8"/>
   <Button x:Name="UpdateDownloadButton" Content="다운로드" Padding="12,8" Margin="0,0,8,8"/>
   <Button x:Name="UpdateInstallButton" Content="업데이트 설치" Padding="12,8" Margin="0,0,8,8"/>
   <Button x:Name="UpdateCancelButton" Content="작업 취소" Padding="12,8" Margin="0,0,8,8"/>
   <Button x:Name="UpdateCloseButton" Content="닫기" Padding="12,8" Margin="0,0,0,8"/>
  </WrapPanel>
 </Grid>
</Window>
