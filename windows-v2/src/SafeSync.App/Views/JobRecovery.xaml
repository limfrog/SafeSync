<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource SafeSyncTextBrush}">
<StackPanel><TextBlock x:Name="RecoveryJobName" Foreground="{DynamicResource SafeSyncMutedBrush}"/><TextBlock x:Name="RecoveryTitle" Text="문제 해결" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock x:Name="RecoveryRunStatus" Margin="0,6,0,10" Foreground="{DynamicResource SafeSyncAccentBrush}" TextWrapping="Wrap"/>
<TextBlock x:Name="RecoveryGuidance" TextWrapping="Wrap" Margin="0,0,0,10"/>
<TextBox x:Name="RecoveryError" IsReadOnly="True" TextWrapping="Wrap" MinHeight="45" MaxHeight="90" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SafeSyncInputBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" BorderBrush="{DynamicResource SafeSyncBorderBrush}" Padding="7"/>
<TextBlock x:Name="RecoveryLocations" TextWrapping="Wrap" Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,8,0,10"/>
<WrapPanel><Button x:Name="RecoveryRetryButton" Content="이 작업 다시 시도" Background="{DynamicResource SafeSyncAccentDarkBrush}" Foreground="White" Margin="0,0,6,6"/><Button x:Name="RecoveryOpenButton" Content="백업 위치 열기" Margin="0,0,6,6"/><Button x:Name="RecoveryConflictsButton" Content="파일 비교 및 처리" Margin="0,0,6,6"/><Button x:Name="RecoveryAccountsButton" Content="계정 연결" Margin="0,0,6,6"/><Button x:Name="RecoveryRebindButton" Content="클라우드 위치 다시 연결" Margin="0,0,6,6"/><Button x:Name="RecoveryEditButton" Content="작업 설정" Margin="0,0,6,6"/><Button x:Name="RecoveryWaitButton" Content="일단 대기" Margin="0,0,6,6"/></WrapPanel>
</StackPanel></UserControl>
