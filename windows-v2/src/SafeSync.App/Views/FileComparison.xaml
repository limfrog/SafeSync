<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI, Malgun Gothic" FontSize="12" Foreground="{DynamicResource SafeSyncTextBrush}" UseLayoutRounding="True">
<UserControl.Resources>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/></Style>
<Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SafeSyncMutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,8,0,3"/></Style>
<Style x:Key="Value" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{DynamicResource SafeSyncSurfaceBrush}" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SafeSyncBorderSoftBrush}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SafeSyncSubtleBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SafeSyncAccentBrush}"/><Setter TargetName="Row" Property="BorderThickness" Value="3,0,0,1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</UserControl.Resources>
<Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock x:Name="ComparisonSummary" Margin="0,0,0,8" Foreground="{DynamicResource SafeSyncMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="180" MinWidth="120"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*" MinWidth="390"/></Grid.ColumnDefinitions>
<ListBox x:Name="ComparisonFiles" SelectionMode="Extended"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Issue.File}"/><TextBlock Text="{Binding Issue.File}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding Kind}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding ActionText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SafeSyncAccentBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" Background="{DynamicResource SafeSyncBorderSoftBrush}" ResizeDirection="Columns" ShowsPreview="True"/>
<Grid Grid.Column="2" Margin="9,0,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer x:Name="ComparisonDetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<ContentControl x:Name="RecoveryDetailsHost" Visibility="Collapsed"/>
<StackPanel x:Name="FileDetailsPanel"><TextBlock x:Name="ComparisonReason" TextWrapping="Wrap" Foreground="{DynamicResource SafeSyncWarningBrush}" Margin="0,0,0,8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource SafeSyncSurfaceBrush}" BorderBrush="{DynamicResource SafeSyncBorderSoftBrush}" BorderThickness="1" Padding="10"><StackPanel><TextBlock Text="왼쪽 · 원본" FontWeight="SemiBold" Foreground="{DynamicResource SafeSyncAccentBrush}"/><TextBlock Text="파일 위치" Style="{StaticResource Label}"/><TextBlock x:Name="CompareSourcePath" Style="{StaticResource Value}"/><TextBlock Text="파일 크기" Style="{StaticResource Label}"/><TextBlock x:Name="CompareSourceSize" Style="{StaticResource Value}"/><TextBlock Text="파일 생성일시" Style="{StaticResource Label}"/><TextBlock x:Name="CompareSourceCreated" Style="{StaticResource Value}"/><TextBlock Text="마지막 수정일시" Style="{StaticResource Label}"/><TextBlock x:Name="CompareSourceModified" Style="{StaticResource Value}"/><TextBlock x:Name="CompareSourceState" TextWrapping="Wrap" Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
<Border Grid.Column="2" Background="{DynamicResource SafeSyncSurfaceBrush}" BorderBrush="{DynamicResource SafeSyncBorderSoftBrush}" BorderThickness="1" Padding="10"><StackPanel><TextBlock Text="오른쪽 · 백업" FontWeight="SemiBold" Foreground="{DynamicResource SafeSyncSuccessTextBrush}"/><TextBlock Text="파일 위치" Style="{StaticResource Label}"/><TextBlock x:Name="CompareBackupPath" Style="{StaticResource Value}"/><TextBlock Text="파일 크기" Style="{StaticResource Label}"/><TextBlock x:Name="CompareBackupSize" Style="{StaticResource Value}"/><TextBlock Text="파일 생성일시" Style="{StaticResource Label}"/><TextBlock x:Name="CompareBackupCreated" Style="{StaticResource Value}"/><TextBlock Text="마지막 수정일시" Style="{StaticResource Label}"/><TextBlock x:Name="CompareBackupModified" Style="{StaticResource Value}"/><TextBlock x:Name="CompareBackupState" TextWrapping="Wrap" Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
</Grid><TextBlock x:Name="ComparisonStatus" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SafeSyncMutedBrush}"/><TextBlock x:Name="ComparisonDuplicatesText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SafeSyncWarningBrush}"/><Button x:Name="CompareDuplicatesButton" Content="중복 이름만 정리 · 사본 모두 보존" Margin="0,8,0,0" HorizontalAlignment="Left"/></StackPanel>
</StackPanel></ScrollViewer>
<StackPanel x:Name="ComparisonActionsPanel" Grid.Row="1" Margin="0,8,0,0"><UniformGrid Columns="2"><Button x:Name="CompareForwardButton" Content="원본 → 백업 덮어쓰기" Margin="0,0,5,5"/><Button x:Name="CompareReverseButton" Content="백업 → 원본 덮어쓰기" Margin="0,0,0,5"/><Button x:Name="CompareKeepBothButton" Content="이름 변경 · 둘 다 보관" ToolTip="기존 백업의 이름을 바꾸어 보관하고 원본을 백업 위치에 복사합니다." Margin="0,0,5,0"/><Button x:Name="CompareIgnoreButton" Content="이번 동기화에서 제외"/></UniformGrid><TextBlock x:Name="ComparisonChoiceHint" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource SafeSyncMutedBrush}"/></StackPanel>
</Grid></Grid>
<DockPanel Grid.Row="2" Margin="0,8,0,0"><Button x:Name="CompareApplyButton" DockPanel.Dock="Right" Content="선택한 처리 적용" Background="{DynamicResource SafeSyncAccentDarkBrush}" Foreground="White" Margin="8,0,0,0"/><WrapPanel><Button x:Name="CompareRefreshButton" Content="정보 다시 확인" Margin="0,0,6,4"/><Button x:Name="CompareStopButton" Content="현재 파일 마치고 종료" Visibility="Collapsed" Margin="0,0,6,4"/><Button x:Name="CompareRecoveryButton" Content="작업 문제 해결" Margin="0,0,6,4"/><Button x:Name="CompareSourceTrashButton" Content="원본 휴지통" Margin="0,0,0,4"/></WrapPanel></DockPanel>
</Grid></UserControl>
