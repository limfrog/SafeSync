<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SafeSync 동기화 상태" Width="1180" Height="800" MinWidth="720" MinHeight="600" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip" Background="{DynamicResource SafeSyncWindowBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" FontFamily="Segoe UI, Malgun Gothic" FontSize="12" UseLayoutRounding="True">
<Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="30"/><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.90"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.46"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/></Style>
    <Style TargetType="DataGrid"><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="36"/><Setter Property="RowBackground" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SafeSyncSubtleBrush}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="7,4"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SafeSyncAccentDarkBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridColumnHeadersPresenter"><Setter Property="Background" Value="{DynamicResource SafeSyncHeadingBrush}"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SafeSyncHeadingBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="9,6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type DataGridColumnHeader}"><Grid SnapsToDevicePixels="True"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" RecognizesAccessKey="True"/></Border><Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="4" Background="{TemplateBinding Background}" Cursor="SizeWE"/><Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="4" Background="{TemplateBinding Background}" Cursor="SizeWE"/><Border HorizontalAlignment="Right" Width="1" Background="{DynamicResource SafeSyncBorderSoftBrush}"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  
<Style TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="CellText" TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/><Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=DataGridCell}}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
<Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True" Background="{DynamicResource SafeSyncSubtleBrush}"/><Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" Padding="16,10" BorderThickness="0,0,0,2" BorderBrush="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource SafeSyncAccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="ResultBadge" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncMutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SafeSyncSuccessTextBrush}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource SafeSyncDangerBrush}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource SafeSyncWarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Active"><Setter Property="Foreground" Value="{DynamicResource SafeSyncAccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style><Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="{DynamicResource SafeSyncSubtleBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="{DynamicResource SafeSyncMutedBrush}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" Margin="2" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Border><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers></Style>
</Window.Resources>
<Grid x:Name="ProgressRoot" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ProgressHistoryRow" Height="210" MinHeight="90"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="280"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="동기화 상태" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="SessionSummaryText" Text="이번 실행의 동기화 작업을 기록합니다." Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,4,0,0"/></StackPanel><Button x:Name="FollowLatestButton" Grid.Column="1" Content="최신 작업 보기" VerticalAlignment="Center"/></Grid>
<Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,7"><TextBlock Text="작업 이력" FontWeight="SemiBold"/><TextBlock x:Name="HistoryCountText" Text="0회" Margin="8,0,0,0" Foreground="{DynamicResource SafeSyncMutedBrush}"/></DockPanel>
<DataGrid x:Name="HistoryGrid" Grid.Row="1" SelectionMode="Single" CanUserSortColumns="False"><DataGrid.Columns>
<DataGridTextColumn Header="작업 이름" Binding="{Binding JobName,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="1.5*" MinWidth="150"/>
<DataGridTextColumn Header="시작" Binding="{Binding StartedText,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="126" MinWidth="126"/>
<DataGridTextColumn Header="종료" Binding="{Binding EndedText,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="78" MinWidth="78"/>
<DataGridTextColumn Header="경과" Binding="{Binding DurationText,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="78" MinWidth="78"/>
<DataGridTemplateColumn Header="결과" Width="125" MinWidth="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" Style="{StaticResource ResultBadge}" VerticalAlignment="Center" ToolTip="{Binding Summary}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="복사" Binding="{Binding CopiedText,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="56" MinWidth="56"/>
<DataGridTextColumn Header="동일" Binding="{Binding SkippedText,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="56" MinWidth="56"/>
<DataGridTextColumn Header="휴지통" Binding="{Binding TrashedText,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="62" MinWidth="62"/>
<DataGridTextColumn Header="대기" Binding="{Binding LockedText,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="56" MinWidth="56"/>
<DataGridTextColumn Header="충돌" Binding="{Binding ConflictsText,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="56" MinWidth="56"/>
<DataGridTextColumn Header="오류" Binding="{Binding ErrorsText,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="56" MinWidth="56"/>
</DataGrid.Columns></DataGrid><TextBlock x:Name="HistoryEmptyText" Grid.Row="1" Text="아직 실행한 동기화가 없습니다." Foreground="{DynamicResource SafeSyncMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
<GridSplitter x:Name="ProgressLayoutSplitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource SafeSyncBorderSoftBrush}" ShowsPreview="True" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
<Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="{DynamicResource SafeSyncSurfaceBrush}" BorderBrush="{DynamicResource SafeSyncBorderSoftBrush}" BorderThickness="1" Padding="12" Margin="0,4,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock x:Name="SourceSummaryDetail" Text="선택한 작업" Foreground="{DynamicResource SafeSyncMutedBrush}" FontSize="11"/><TextBlock x:Name="SourceSummaryPath" Text="작업 이력을 선택하세요." Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></StackPanel>
<TextBlock x:Name="DirectionText" Grid.Column="1" Text="→" FontSize="22" Foreground="{DynamicResource SafeSyncAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<StackPanel Grid.Column="2"><TextBlock x:Name="DestinationSummaryDetail" Text="백업 위치" Foreground="{DynamicResource SafeSyncMutedBrush}" FontSize="11"/><TextBlock x:Name="DestinationSummaryPath" Text="—" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></StackPanel></Grid></Border>
<TabControl x:Name="ProgressTabs" Grid.Row="1">
<TabItem x:Name="ActivityTab" Header="진행 상세"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button x:Name="ProgressPauseButton" Content="일시정지" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBlock x:Name="ActiveSummaryText" Text="대기 중" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ItemsControl x:Name="ProgressItems"><ItemsControl.ItemTemplate><DataTemplate><StackPanel>
<DockPanel><TextBlock Text="{Binding ProgressText}" DockPanel.Dock="Right" Foreground="{DynamicResource SafeSyncAccentBrush}"/><TextBlock Text="{Binding JobName}" FontSize="15" FontWeight="SemiBold"/></DockPanel>
<TextBlock Text="{Binding StageText}" Foreground="{DynamicResource SafeSyncAccentBrush}" Margin="0,10,0,6" TextWrapping="Wrap"/>
<ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate,Mode=OneWay}" Foreground="{DynamicResource SafeSyncAccentBrush}" Background="{DynamicResource SafeSyncSubtleBrush}" BorderThickness="0"/>
<TextBlock Text="현재 파일 / 폴더" Foreground="{DynamicResource SafeSyncMutedBrush}" FontSize="11" Margin="0,14,0,5"/><TextBlock Text="{Binding FileText}" TextWrapping="Wrap" ToolTip="{Binding FileText}"/>
</StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<StackPanel x:Name="ResultSummaryPanel" Margin="0,5,0,0"><TextBlock x:Name="ResultTitleText" Text="작업을 기다리고 있습니다." FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ResultDetailText" Foreground="{DynamicResource SafeSyncMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock x:Name="HistoryHintText" Foreground="{DynamicResource SafeSyncMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0"/></StackPanel>
</StackPanel></ScrollViewer></Grid></TabItem>
<TabItem x:Name="ConflictTab"><TabItem.Header><TextBlock x:Name="ConflictTabHeader" Text="충돌 0"/></TabItem.Header><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel Margin="0,0,0,10"><TextBlock x:Name="ConflictSummaryText" Text="충돌이 없습니다." VerticalAlignment="Center" Margin="0,0,14,0"/><Button x:Name="ConflictAllOverwriteButton" Content="모두 덮어쓰기" Margin="0,0,6,4"/><Button x:Name="ConflictAllRenameButton" Content="모두 이름 변경 후 복사" Margin="0,0,6,4"/><Button x:Name="ConflictAllIgnoreButton" Content="모두 변경 안 함" Margin="0,0,0,4"/></WrapPanel>
<DataGrid x:Name="ProgressConflictGrid" Grid.Row="1" RowHeight="76" SelectionMode="Extended"><DataGrid.Columns>
<DataGridTextColumn Header="작업 / 파일" Binding="{Binding FileDisplay,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="1.5*" MinWidth="140"/>
<DataGridTextColumn Header="원본" Binding="{Binding SourceInfo,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="140" MinWidth="140"/>
<DataGridTextColumn Header="현재 백업" Binding="{Binding BackupInfo,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="140" MinWidth="140"/>
<DataGridTextColumn Header="충돌 이유" Binding="{Binding Reason,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="1.5*"/>
<DataGridTemplateColumn Header="처리 방법" Width="275" MinWidth="275"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><WrapPanel>
<Button Content="원본 → 백업" Tag="Overwrite" IsEnabled="{Binding CanResolve}" Padding="7,4" Margin="0,0,4,4"/><Button Content="백업 → 원본" Tag="UseBackup" IsEnabled="{Binding CanUseBackup}" Padding="7,4" Margin="0,0,4,4"/><Button Content="이름 변경 후 복사" Tag="RenameThenCopy" IsEnabled="{Binding CanResolve}" Padding="7,4" Margin="0,0,4,4"/><Button Content="변경 안 함" Tag="Ignore" IsEnabled="{Binding CanResolve}" Padding="7,4" Margin="0,0,0,4"/></WrapPanel><TextBlock Text="{Binding ActionLabel}" FontSize="11" Foreground="{DynamicResource SafeSyncAccentBrush}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
</DataGrid.Columns></DataGrid>
<DockPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="ApplyConflictActionsButton" Content="선택한 처리 적용" DockPanel.Dock="Right" Background="{DynamicResource SafeSyncAccentDarkBrush}" Foreground="White"/><TextBlock Text="이름 변경 후 복사는 기존 백업 사본을 같은 위치에 보존합니다." Foreground="{DynamicResource SafeSyncMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/></DockPanel>
</Grid></TabItem>
<TabItem x:Name="LockedTab"><TabItem.Header><TextBlock x:Name="LockedTabHeader" Text="사용 중 0"/></TabItem.Header><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><Button x:Name="RetryLockedButton" Content="이 작업 다시 시도" DockPanel.Dock="Right"/><TextBlock x:Name="LockedSummaryText" Text="사용 중인 파일이 없습니다." VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/></DockPanel>
<DataGrid x:Name="ProgressLockedGrid" Grid.Row="1" RowHeight="45"><DataGrid.Columns><DataGridTextColumn Header="작업 / 파일" Binding="{Binding FileDisplay,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="2*"/>
<DataGridTextColumn Header="상태" Binding="{Binding StatusText,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="2*"/>
<DataGridTextColumn Header="대기 시작" Binding="{Binding WaitingSince,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="120" MinWidth="120"/>
<DataGridTextColumn Header="재시도" Binding="{Binding RetryCount,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="70" MinWidth="70"/>
<DataGridTextColumn Header="확인 시각" Binding="{Binding LastAttempt,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="100" MinWidth="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>
<TabItem x:Name="ErrorsTab"><TabItem.Header><TextBlock x:Name="ErrorsTabHeader" Text="오류 0"/></TabItem.Header><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ErrorSummaryText" Text="오류가 없습니다." Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
<DataGrid x:Name="ProgressErrorGrid" Grid.Row="1" RowHeight="NaN" MinRowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="파일 / 항목" Binding="{Binding File,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="1.5*"/><DataGridTextColumn Header="오류 내용" Binding="{Binding Reason,Mode=OneWay}" Width="3*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,5"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
</TabControl></Grid>
<TextBlock Grid.Row="4" Text="창을 닫아도 백업은 계속됩니다. 작업 이력은 이번 프로그램 실행 동안만 보관됩니다." Foreground="{DynamicResource SafeSyncMutedBrush}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
</Grid>
</Window>
