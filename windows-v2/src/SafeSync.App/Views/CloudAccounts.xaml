<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="클라우드 계정" Width="800" Height="760" MinWidth="700" MinHeight="480" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource SafeSyncWindowBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource SafeSyncInputBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource SafeSyncInputBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}">
    <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.86"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.70"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource SafeSyncAccentBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type GroupBox}"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><StackPanel><ContentPresenter ContentSource="Header" TextElement.FontSize="16" TextElement.FontWeight="SemiBold" Margin="0,0,0,10"/><ContentPresenter ContentSource="Content"/></StackPanel></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="CloudAccountsLayout" Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="클라우드 계정 연결" FontSize="23" FontWeight="Bold"/><TextBlock Text="연결 정보는 Windows 사용자 계정으로 암호화되어 이 PC에만 저장됩니다." Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,5,0,0"/></StackPanel>
  <ScrollViewer x:Name="AccountsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <GroupBox Header="Dropbox" Padding="16" Margin="0,0,0,14">
   <StackPanel>
    <TextBlock x:Name="DropboxLoginHint" Text="아래 버튼을 누르면 Dropbox 공식 로그인 페이지가 브라우저에서 열립니다.&#10;본인 계정으로 로그인하고 SafeSync 연결을 허용하세요. App Key를 입력할 필요가 없습니다."/>
    <TextBlock Text="SafeSync는 Dropbox 아이디·비밀번호를 직접 받거나 저장하지 않습니다. 연결 후 백업할 폴더를 선택하거나 새로 만들 수 있습니다." Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,6,0,0" FontSize="12"/>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="DropboxConnect" Content="Dropbox로 로그인" Background="{DynamicResource SafeSyncAccentBrush}" Foreground="White" BorderBrush="{DynamicResource SafeSyncAccentBrush}"/><Button x:Name="DropboxValidate" Content="연결 검증"/><Button x:Name="DropboxDisconnect" Content="연결 해제"/></StackPanel><TextBlock x:Name="DropboxStatus" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SafeSyncMutedBrush}"/></Grid>
    <TextBlock Text="공개 심사 신청은 접수됐으며 승인 전까지 개발 사용자 한도가 적용됩니다." Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,10,0,0" FontSize="12"/>
    <Expander x:Name="DropboxDeveloperSettings" Header="개발자 설정 · 일반 사용자는 변경할 필요가 없습니다" IsExpanded="False" Margin="0,10,0,0" Foreground="{DynamicResource SafeSyncMutedBrush}" Background="{DynamicResource SafeSyncSurfaceBrush}" BorderBrush="{DynamicResource SafeSyncBorderBrush}">
     <Expander.Template><ControlTemplate TargetType="{x:Type Expander}"><StackPanel>
      <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Cursor="Hand">
       <ToggleButton.Template><ControlTemplate TargetType="{x:Type ToggleButton}"><Border x:Name="DeveloperHeader" Background="Transparent" Padding="0,4" CornerRadius="4"><DockPanel><TextBlock x:Name="Chevron" Text="›" FontSize="16" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}"/><ContentPresenter VerticalAlignment="Center"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DeveloperHeader" Property="Background" Value="{DynamicResource SafeSyncSubtleBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DeveloperHeader" Property="Background" Value="{DynamicResource SafeSyncSubtleBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="DeveloperContent" Visibility="Collapsed" ContentSource="Content"/>
     </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="DeveloperContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Expander.Template>
     <StackPanel Margin="0,10,0,0">
      <TextBlock Text="SafeSync 등록 앱의 키가 자동으로 적용됩니다. 비워 저장하면 기본값을 사용합니다. 다른 개발자 앱의 키로 변경하면 기존 연결이 해제됩니다." FontSize="12" Margin="0,0,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="App Key" VerticalAlignment="Center"/><TextBox x:Name="DropboxKey" Grid.Column="1"/></Grid>
      <TextBlock Text="Redirect URI: http://127.0.0.1:53682/" FontFamily="Consolas" Margin="0,5,0,0" Foreground="{DynamicResource SafeSyncMutedBrush}" FontSize="12"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </GroupBox>
  <GroupBox Header="Google Drive — 전체 Drive" Padding="16">
   <StackPanel>
    <TextBlock Text="Drive API를 켜고 OAuth 클라이언트를 ‘데스크톱 앱’으로 생성하세요.&#10;테스트 중인 앱은 OAuth 동의 화면에 본인 계정을 테스트 사용자로 등록합니다."/>
    <Grid Margin="0,10,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Client ID" VerticalAlignment="Center"/><TextBox x:Name="GoogleClientId" Grid.Column="1"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Client Secret" VerticalAlignment="Center"/><PasswordBox x:Name="GoogleSecret" Grid.Column="1"/></Grid>
    <TextBlock Text="Client Secret을 비워 두면 기존에 암호화 저장된 값을 유지합니다." Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="110,4,0,0" FontSize="12"/>
    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="GoogleConnect" Content="Google Drive 연결"/><Button x:Name="GoogleValidate" Content="연결 검증"/><Button x:Name="GoogleDisconnect" Content="연결 해제"/></StackPanel><TextBlock x:Name="GoogleStatus" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SafeSyncMutedBrush}"/></Grid>
   </StackPanel>
  </GroupBox>
  </StackPanel></ScrollViewer>
  <Border x:Name="ValidationPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,14,0,0" Padding="14" Background="{DynamicResource SafeSyncSurfaceBrush}" BorderBrush="{DynamicResource SafeSyncBorderBrush}" BorderThickness="1" CornerRadius="8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ProgressBar x:Name="ValidationProgress" Width="34" Height="6" Margin="0,7,12,0" VerticalAlignment="Top" IsIndeterminate="True"/>
    <StackPanel Grid.Column="1"><TextBlock x:Name="ValidationTitle" Text="연결 검증" FontWeight="SemiBold"/><TextBlock x:Name="ValidationResult" Margin="0,4,0,0" Foreground="{DynamicResource SafeSyncMutedBrush}" TextWrapping="Wrap"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="3" BorderBrush="{DynamicResource SafeSyncBorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="SaveCredentials" Content="입력값 저장"/><Button x:Name="CloseButton" Content="닫기" MinWidth="80" Margin="0" Background="{DynamicResource SafeSyncAccentBrush}" Foreground="White" BorderBrush="{DynamicResource SafeSyncAccentBrush}"/></StackPanel></Border>
 </Grid>
</Window>
