<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SafeSync 대량 변경 검토" Width="960" Height="640" MinWidth="740" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource SafeSyncWindowBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" FontFamily="Segoe UI, Malgun Gothic" FontSize="12">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SafeSyncSubtleBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="Padding" Value="8"/></Style></Window.Resources>
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="대량 변경을 보류했습니다" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Margin="0,12,0,12" TextWrapping="Wrap" Foreground="{DynamicResource SafeSyncMutedBrush}"/></StackPanel>
<TextBlock Grid.Row="1" Text="파일 목록을 확인하세요. 허용은 아래 변경 목록에 대해 다음 실행에서 한 번만 적용되며, 실행 전에 목록이나 위치가 바뀌면 다시 보류합니다. 기존 사본은 휴지통에 보관됩니다." TextWrapping="Wrap" Margin="0,0,0,14"/>
<DataGrid x:Name="ChangesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" Background="{DynamicResource SafeSyncSurfaceBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" RowBackground="{DynamicResource SafeSyncSurfaceBrush}" AlternatingRowBackground="{DynamicResource SafeSyncSubtleBrush}" BorderBrush="{DynamicResource SafeSyncBorderSoftBrush}" RowHeight="32"><DataGrid.Columns><DataGridTextColumn Header="파일 경로" Binding="{Binding Path}" Width="3*"/><DataGridTextColumn Header="위치" Binding="{Binding Side}" Width="90"/><DataGridTextColumn Header="변경" Binding="{Binding Action}" Width="90"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="CancelButton" Content="보류 유지"/><Button x:Name="ApproveButton" Content="확인한 변경 1회 허용" Background="{DynamicResource SafeSyncAccentBrush}" Foreground="White"/></StackPanel></Grid></Window>
