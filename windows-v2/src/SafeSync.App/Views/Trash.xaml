<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="clr-namespace:SafeSync.App;assembly=SafeSync"
Title="SafeSync 휴지통" Width="1080" Height="700" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen"
Background="{DynamicResource SafeSyncWindowBrush}" Foreground="{DynamicResource SafeSyncTextBrush}" FontFamily="Segoe UI, Malgun Gothic" FontSize="12" UseLayoutRounding="True">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="30"/><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.90"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.46"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/></Style>
<Style TargetType="DataGrid"><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="36"/><Setter Property="RowBackground" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource SafeSyncSubtleBrush}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/></Style>
<Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource SafeSyncSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/></Style>
<Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="7,4"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SafeSyncAccentDarkBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
<Style TargetType="DataGridColumnHeadersPresenter"><Setter Property="Background" Value="{DynamicResource SafeSyncHeadingBrush}"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource SafeSyncHeadingBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderSoftBrush}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="9,6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type DataGridColumnHeader}"><Grid SnapsToDevicePixels="True"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" RecognizesAccessKey="True"/></Border><Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="4" Background="{TemplateBinding Background}" Cursor="SizeWE"/><Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="4" Background="{TemplateBinding Background}" Cursor="SizeWE"/><Border HorizontalAlignment="Right" Width="1" Background="{DynamicResource SafeSyncBorderSoftBrush}"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="{DynamicResource SafeSyncSubtleBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="{DynamicResource SafeSyncMutedBrush}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" Margin="2" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Border><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers></Style>
<app:TrashSizeConverter x:Key="TrashSize"/>
<Style x:Key="CellText" TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=DataGridCell}}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource SafeSyncInputBrush}"/><Setter Property="Foreground" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource SafeSyncTextBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource SafeSyncAccentDarkBrush}"/><Setter Property="SelectionTextBrush" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource SafeSyncBorderBrush}"/><Setter Property="Padding" Value="9,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></Window.Resources>
<Grid x:Name="TrashRoot" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="휴지통" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="JobText" Text="선택한 백업 작업" Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="BackupLocationText" Text="백업 위치" Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TotalsText" Text="전체 0개" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="RetentionText" Text="파일별 보기" Foreground="{DynamicResource SafeSyncMutedBrush}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Right"/></StackPanel></Grid>
<Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="RefreshButton" Content="새로고침" Margin="0,0,8,0"/><Button x:Name="SelectAllButton" Grid.Column="1" Content="전체 선택" ToolTip="검색 결과에 표시된 파일만 선택" Margin="0,0,8,0"/><Button x:Name="ClearSelectionButton" Grid.Column="2" Content="선택 해제"/>
<Grid Grid.Column="3" Width="320" HorizontalAlignment="Right" Margin="18,0,0,0"><TextBox x:Name="SearchBox" Padding="9,7,30,7" MaxLength="500"/><TextBlock x:Name="SearchHint" Text="파일 이름 / 원래 경로 검색" Foreground="{DynamicResource SafeSyncMutedBrush}" IsHitTestVisible="False" Margin="10,0,30,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button x:Name="ClearSearchButton" Content="×" ToolTip="검색 지우기" Width="25" MinHeight="24" Padding="0" HorizontalAlignment="Right" Margin="0,2,2,2" Background="Transparent" BorderThickness="0" IsEnabled="False"/></Grid></Grid>
<Grid Grid.Row="2" Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="파일 목록을 불러오는 중…" TextWrapping="Wrap" Foreground="{DynamicResource SafeSyncMutedBrush}" VerticalAlignment="Center"/><TextBlock x:Name="VisibleCountText" Grid.Column="1" Text="표시 0개" Foreground="{DynamicResource SafeSyncMutedBrush}" Margin="15,0,0,0" VerticalAlignment="Center"/></Grid><ProgressBar x:Name="BusyProgress" Grid.Row="1" Height="3" Margin="0,7,0,0" IsIndeterminate="True" Foreground="{DynamicResource SafeSyncAccentBrush}" Background="{DynamicResource SafeSyncSubtleBrush}" BorderThickness="0" Visibility="Collapsed"/></Grid>
<Grid Grid.Row="3"><DataGrid x:Name="TrashGrid" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="36" BorderThickness="1" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
<DataGridTextColumn Header="파일 이름" Binding="{Binding Name,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="1.3*" MinWidth="180"/>
<DataGridTextColumn Header="삭제 시각" Binding="{Binding DeletedAtText,Mode=OneWay}" SortMemberPath="DeletedAt" ElementStyle="{StaticResource CellText}" Width="166" MinWidth="166"/>
<DataGridTextColumn Header="원래 경로" Binding="{Binding OriginalPath,Mode=OneWay}" ElementStyle="{StaticResource CellText}" Width="3*" MinWidth="240"/>
<DataGridTextColumn Header="크기" Binding="{Binding Length,Converter={StaticResource TrashSize},Mode=OneWay}" SortMemberPath="Length" ElementStyle="{StaticResource CellText}" Width="92" MinWidth="92"/>
</DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyText" Text="휴지통이 비어 있습니다." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SafeSyncMutedBrush}" IsHitTestVisible="False"/></Grid>
<Border Grid.Row="4" BorderBrush="{DynamicResource SafeSyncBorderSoftBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,10"><StackPanel><TextBlock x:Name="SelectionText" Text="선택한 파일 없음" FontWeight="SemiBold"/><TextBlock x:Name="SelectedFileText" Text="목록에서 파일을 선택하면 전체 경로와 삭제 시각을 확인할 수 있습니다." Foreground="{DynamicResource SafeSyncMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/><TextBox x:Name="SelectedOriginalPath" Text="" IsReadOnly="True" BorderThickness="0" Padding="0,5,0,0" Background="Transparent" Foreground="{DynamicResource SafeSyncMutedBrush}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
<Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="DeleteButton" Content="완전 삭제" Foreground="{DynamicResource SafeSyncDangerBrush}" BorderBrush="{DynamicResource SafeSyncDangerBrush}"/><Button x:Name="SourceTrashButton" Grid.Column="1" Content="원본 휴지통" Visibility="Collapsed" HorizontalAlignment="Left" Margin="8,0,0,0"/><Button x:Name="RestoreButton" Grid.Column="2" Content="선택 파일 복구" Background="{DynamicResource SafeSyncAccentDarkBrush}" Foreground="White" Margin="8,0,0,0"/><Button x:Name="CloseButton" Grid.Column="3" Content="닫기" Margin="8,0,0,0"/></Grid>
<TextBlock x:Name="DeletionPolicyText" Grid.Row="6" Text="복구 후 작업은 일시정지됩니다. 완전 삭제는 되돌릴 수 없습니다." Foreground="{DynamicResource SafeSyncMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
</Grid></Window>
